<?xml version="1.0" encoding="UTF-8"?>
<!-- Pure tests: helpers, device parsers, libraries without CodeIgniter. No database, no server. -->
<phpunit
    bootstrap="tests/bootstrap-light.php"
    cacheDirectory=".phpunit.cache"
    colors="true"
>
    <testsuites>
        <testsuite name="pure">
            <directory>tests/Pure</directory>
        </testsuite>
    </testsuites>
</phpunit>
