<?xml version="1.0" encoding="UTF-8"?>
<!--
    Suites that start CodeIgniter 3 inside the test process (needs the database, see tests/README.md).
    The other layers have their own configuration:
        phpunit.pure.xml.dist   no framework, no database
        phpunit.http.xml.dist   black-box tests against the running application
-->
<phpunit
    bootstrap="tests/bootstrap.php"
    cacheDirectory=".phpunit.cache"
    colors="true"
>
    <testsuites>
        <testsuite name="model">
            <directory>tests/Models</directory>
            <directory>tests/Integration</directory>
            <directory>tests/Migrations</directory>
            <directory>tests/Views</directory>
            <directory>tests/Libraries</directory>
            <directory>tests/Controllers</directory>
        </testsuite>
        <testsuite name="pure">
            <directory>tests/Pure</directory>
        </testsuite>
    </testsuites>
</phpunit>
