{
    "_comment": "08/08/2026 - select2-bootstrap4 is not supporting select2 4.1* yet",
    "require": {
        "nnnick/chartjs": "4.5.*",
        "components/bootstrap": "4.*",
        "fortawesome/font-awesome": "7.*",
        "components/jquery": "3.*",
        "select2/select2": "4.1.*",
        "ttskch/select2-bootstrap4-theme": "^1.5",
        "phpmailer/phpmailer": "^7.0",
        "dompdf/dompdf": "3.*",
        "smhg/sepa-qr-data": "^3.0",
        "chillerlan/php-qrcode": "^6.0",
        "robinherbots/jquery.inputmask": "^5.0",
        "clegginabox/pdf-merger": "dev-master",
        "phpoffice/phpspreadsheet": "^5.4",
        "guzzlehttp/guzzle": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13"
    },
    "scripts": {
        "test": [
            "@test:pure",
            "@test:model",
            "@test:http"
        ],
        "test:pure": "phpunit -c phpunit.pure.xml.dist --testdox",
        "test:model": "phpunit -c phpunit.xml.dist --testsuite model --testdox",
        "test:http": "phpunit -c phpunit.http.xml.dist --testdox",
        "test:stable": "phpunit -c phpunit.xml.dist --exclude-group ci3-only --exclude-group known-bug --testdox"
    }
}
